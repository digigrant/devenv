# Pinned versions for devenv. Sourced by bash; KEY=value lines only.
# Every download is verified against the sha256 recorded here before it is
# installed. Update with `devenv bump …` rather than by hand, so versions and
# checksums always move together. Claude Code is deliberately not pinned (it
# updates itself).

# herdr, a terminal multiplexer for agents: https://github.com/herdrdev/herdr
# Firstmate has verified herdr 0.7.1, 0.7.3, 0.7.4, 0.7.5 and 0.8.0
# (Firstmate docs/herdr-backend.md). Assets: herdr-linux-<x86_64|aarch64>.
HERDR_VERSION=0.8.0
HERDR_SHA256_X86_64=b872ea7e40fa2cb17e857ac9b62b1bf26db7b403c622f5d2f3f5b35f6e9acd28
HERDR_SHA256_AARCH64=f647ac66468d9efbc642fe534fb284468f0aea60641606fc008dfc0d82a3ca87

# herdr's Claude detection rules, installed as a local override of the copy
# bundled in the herdr binary. The bundled rules in herdr 0.8.0 predate
# Claude Code 2.1.228's title spinner, so herdr never reports Claude as
# "working" (see docs/SPEC.md V3 and the PR that added this). The file in
# herdr/agent-detection/claude.toml is herdr's own published copy of
# distribution/agent-detection/claude.toml at the commit below, unmodified.
# HERDR_CLAUDE_MANIFEST_HERDR is the herdr version it was tested against;
# `devenv check` warns when HERDR_VERSION moves away from it.
HERDR_CLAUDE_MANIFEST_COMMIT=a05c403881c5a5a6b65317d3dd349b11591fc4c6
HERDR_CLAUDE_MANIFEST_VERSION=2026.09.11.1
HERDR_CLAUDE_MANIFEST_SHA256=038d0aa23fee3f9b39cb3c9ca117d0f95b0b3a5873cf0f38284ccbac279c9664
HERDR_CLAUDE_MANIFEST_HERDR=0.8.0

# treehouse, worktree manager used by Firstmate: https://github.com/kunchenguid/treehouse
# Assets: treehouse-v<ver>-linux-<amd64|arm64>.tar.gz
TREEHOUSE_VERSION=2.3.0
TREEHOUSE_SHA256_X86_64=94fd2b2c20c35aac1ddc2941317890ad82c9916f5ccecbac4a50cda783eed10f
TREEHOUSE_SHA256_AARCH64=408589ba72b58d5e942071ed863a83fd96566cfd1e514945daa59defde528bbb

# no-mistakes: https://github.com/kunchenguid/no-mistakes (Firstmate requires >= 1.46.0)
# Assets: no-mistakes-v<ver>-linux-<amd64|arm64>.tar.gz
NO_MISTAKES_VERSION=1.79.0
NO_MISTAKES_SHA256_X86_64=d178c8a5134763b8e5f6d82545a3a76285fbbcdc13d09020d1091ec80a3f8da6
NO_MISTAKES_SHA256_AARCH64=eac3f8e494c7d2487594b7eb513e605e59588be4ce147390b8fd184a7e6a8b05

# Firstmate's npm tools (installed with `npm install -g`, integrity-checked by npm).
NPM_GH_AXI=0.1.35
NPM_CHROME_DEVTOOLS_AXI=0.1.35
NPM_TASKS_AXI=0.2.6
NPM_QUOTA_AXI=0.1.54

# Node. quota-axi 0.1.54 declares engines.node >=22.19, so that is the floor.
# Plain mode installs the pinned NODE_VERSION tarball (from nodejs.org, checked
# against SHASUMS256.txt) only when node is missing or older than the floor.
NODE_MIN_VERSION=22.19.0
NODE_VERSION=24.21.0
NODE_SHA256_X86_64=6e1db87ef58b8819e5d5402eff1536491b18edd8eb7bee5ef7897876e88dc5ff
NODE_SHA256_AARCH64=724282c3b43aec998aa9527380465b45d229e021b58035f5f4f63095eabfe5d5

# Android (x86_64 Linux only: Google publishes these for no other Linux).
# Downloads come from Google's SDK repository,
# https://dl.google.com/android/repository, which publishes only SHA-1s; the
# sha256s here are devenv's own, computed by `devenv bump` from the files.
# platform-tools (adb) is installed in the sandbox and in plain mode:
# platform-tools_r<version>-linux.zip.
ANDROID_PLATFORM_TOOLS_VERSION=37.0.1
ANDROID_PLATFORM_TOOLS_SHA256=d230f13842f60f782a8645f9c813f8f845bf36089ea7289f28c48f17979313f1
# So is the build toolchain, so phone apps build without a toolchain of their
# own: the command-line tools (sdkmanager, avdmanager;
# commandlinetools-linux-<build>_latest.zip), one platform
# (platforms;<platform>) and one build-tools. cmdline-tools stays at 22.0: from
# 23.0 its sdkmanager hands every command to Google's Android CLI, which
# downloads and updates itself and sends usage metrics by default.
ANDROID_CMDLINE_TOOLS_VERSION=22.0
ANDROID_CMDLINE_TOOLS_BUILD=15859902
ANDROID_CMDLINE_TOOLS_SHA256=4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583
# The platform a project compiles against (compileSdk 37 is android-37.0).
ANDROID_PLATFORM=android-37.0
ANDROID_PLATFORM_REVISION=2
ANDROID_PLATFORM_ZIP=platform-37.0_r02.zip
ANDROID_PLATFORM_SHA256=840b23e827f96e64aea4c89a1194aac3dc5f6bad37edb231c5c795d890330e8d
# build-tools: the default of the Android Gradle Plugin the projects use
# (AGP 9.4.1's is 36.0.0). A build that sets no buildToolsVersion needs that
# one, and can't download it without the SDK license accepted.
ANDROID_BUILD_TOOLS_VERSION=36.0.0
ANDROID_BUILD_TOOLS_ZIP=build-tools_r36_linux.zip
ANDROID_BUILD_TOOLS_SHA256=5d9ac77fb6ff43d9da518a337b4fcf8f9097113df531d99ccefe80ef7ce8250b
# The JDK for it: Eclipse Temurin from GitHub Releases
# (adoptium/temurin<major>-binaries, tag jdk-<version>, asset
# OpenJDK<major>U-jdk_x64_linux_hotspot_<version, + as _>.tar.gz; the sha256 is
# GitHub's recorded digest). 21, the LTS Robolectric runs on. x86_64 only,
# like the rest of the toolchain.
JDK_VERSION=21.0.12.1+1
JDK_SHA256=ce79869e1307ed8ee1e2baa86a412b1eb5b75d10a01006d788a6f968bcfaee94
# The opt-in host emulator (`devenv emulator start`) also uses the emulator
# (stable channel; emulator-linux_x64-<build>.zip), one system image
# (sys-img/<tag>/<zip>, unpacked as system-images/android-<api>/<tag>/x86_64)
# and a base image for its container, pinned by digest.
ANDROID_EMULATOR_VERSION=37.1.11
ANDROID_EMULATOR_BUILD=15917651
ANDROID_EMULATOR_SHA256=95771e0ae431897b2a4bd2d97fa095f29a8b0624a7b216baf529f9306161c266
ANDROID_SYSTEM_IMAGE_API=36
ANDROID_SYSTEM_IMAGE_TAG=google_apis
ANDROID_SYSTEM_IMAGE_REVISION=7
ANDROID_SYSTEM_IMAGE_ZIP=x86_64-36_r07.zip
ANDROID_SYSTEM_IMAGE_SHA256=b1bb0769d0bed7698e61f203d7dc9bf6e7c37cd01a39d0d8788a11186bc78160
ANDROID_EMULATOR_BASE_IMAGE=ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3

# Firstmate is not pinned here: fresh setups clone the owner's fork's main,
# and FIRSTMATE_AUTO_UPDATE (devenv.conf) keeps it current. The fork is the
# control point.

# Test tooling, used only by `devenv test`: shellcheck runs from this image
# (pinned by digest) when shellcheck is not installed.
TEST_SHELLCHECK_IMAGE=koalaman/shellcheck:v0.11.0@sha256:61862eba1fcf09a484ebcc6feea46f1782532571a34ed51fedf90dd25f925a8d

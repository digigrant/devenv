#!/usr/bin/env bash
# Fake secret-tool for tests/secrets.sh. Dummy values only. Logs its argv
# (one line per call) to $FAKE_LOG/argv, and never reads or writes a keyring.
#   FAKE_KR_STATE   ok (default) | locked | missing (only project-id) | nobus
#   FAKE_KR_PROMPT  accept: a lookup on the locked keyring stands for the
#                   owner typing the password into the unlock window, and
#                   unlocks it ($FAKE_LOG/unlocked); otherwise the window is
#                   dismissed and the lookup fails
set -euo pipefail
printf 'secret-tool %s\n' "$*" >> "$FAKE_LOG/argv"
state=${FAKE_KR_STATE:-ok}
[ "$state" = locked ] && [ -e "$FAKE_LOG/unlocked" ] && state=ok
value() {
  case "$1" in
    project-id) printf '%s' "$FAKE_PROJECT_ID" ;;
    client-id) printf '%s' "$FAKE_CLIENT_ID" ;;
    client-secret) printf '%s' "$FAKE_CLIENT_SECRET" ;;
  esac
}
if [ "$state" = nobus ]; then
  echo "secret-tool: Cannot autolaunch D-Bus without X11 \$DISPLAY" >&2; exit 1
fi
case "${1:-}" in
  search)
    [ "$2" = --all ] && [ "$3" = service ] || exit 2
    [ "$4" = devenv-infisical ] || exit 0
    keys=(project-id client-id client-secret)
    [ "$state" = missing ] && keys=(project-id)
    i=0
    for k in "${keys[@]}"; do
      i=$((i + 1))
      [ "$state" = locked ] && echo "secret-tool: Cannot get secret of a locked object" >&2
      printf '[/org/freedesktop/secrets/collection/login/%d]\nlabel = x\n' "$i"
      [ "$state" = locked ] || printf 'secret = %s\n' "$(value "$k")"
      printf 'attribute.key = %s\nattribute.service = devenv-infisical\n' "$k"
    done
    ;;
  lookup)
    [ "$2" = service ] && [ "$4" = key ] || exit 2
    [ "$3" = devenv-infisical ] || exit 1
    if [ "$state" = locked ]; then
      [ "${FAKE_KR_PROMPT:-}" = accept ] || exit 1
      : > "$FAKE_LOG/unlocked"
    fi
    [ "$state" = missing ] && [ "$5" != project-id ] && exit 1
    value "$5"
    ;;
  *) exit 2 ;;
esac

#!/usr/bin/env bash
# Fake secret-tool for tests/secrets.sh. Dummy values only. Logs its argv
# (one line per call) to $FAKE_LOG/argv. `store` keeps what it reads from
# stdin in $FAKE_LOG/kr/<service>/<key>; `lookup` returns that, or else the
# FAKE_* value the keyring starts with.
#   FAKE_KR_STATE   ok (default) | locked | missing (only project-id) |
#                   empty (no entries) | nobus
#   FAKE_KR_PROMPT  accept: a lookup on the locked keyring stands for the
#                   owner typing the password into the unlock window, and
#                   unlocks it ($FAKE_LOG/unlocked); otherwise the window is
#                   dismissed and the lookup fails, as without a display
set -euo pipefail
printf 'secret-tool %s\n' "$*" >> "$FAKE_LOG/argv"
state=${FAKE_KR_STATE:-ok}
[ "$state" = locked ] && [ -e "$FAKE_LOG/unlocked" ] && state=ok
if [ "$state" = nobus ]; then
  echo "secret-tool: Could not connect: No such file or directory" >&2; exit 1
fi
initial() {
  [ "$1" = devenv-infisical ] || return 1
  case "$state:$2" in
    empty:*) return 1 ;;
    missing:project-id) printf '%s' "$FAKE_PROJECT_ID" ;;
    missing:*) return 1 ;;
    *:project-id) printf '%s' "$FAKE_PROJECT_ID" ;;
    *:client-id) printf '%s' "$FAKE_CLIENT_ID" ;;
    *:client-secret) printf '%s' "$FAKE_CLIENT_SECRET" ;;
    *) return 1 ;;
  esac
}
case "${1:-}" in
  lookup)
    [ "$2" = service ] && [ "$4" = key ] && [ $# -eq 5 ] || exit 2
    if [ "$state" = locked ]; then
      [ "${FAKE_KR_PROMPT:-}" = accept ] || exit 1
      : > "$FAKE_LOG/unlocked"
    fi
    if [ -f "$FAKE_LOG/kr/$3/$5" ]; then cat "$FAKE_LOG/kr/$3/$5"; else initial "$3" "$5"; fi
    ;;
  store)
    case "${2:-}" in --label=?*) ;; *) exit 2 ;; esac
    [ "$3" = service ] && [ "$5" = key ] && [ $# -eq 6 ] || exit 2
    [ "$state" = locked ] && exit 1
    mkdir -p "$FAKE_LOG/kr/$4"
    cat > "$FAKE_LOG/kr/$4/$6"
    ;;
  *) exit 2 ;;
esac
